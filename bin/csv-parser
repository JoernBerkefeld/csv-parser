#!/usr/bin/env node

import { EOL } from 'node:os';
import { Transform } from 'node:stream';
import fs from 'node:fs';
import csv from '../index.js';

const package_ = JSON.parse(fs.readFileSync(new URL('../package.json', import.meta.url), 'utf8'));

/**
 * Parse the existing CLI options without changing accepted flags.
 * @returns {object} Parsed command-line options.
 */
function parseArguments() {
    let skipComments;
    let escape = '"';
    let headers;
    let output;
    let quote = '"';
    let skipLines;
    let separator = ',';
    let version;
    let help;
    const defaultArguments = [];

    const arguments_ = process.argv.slice(2);
    for (let index = 0; index < arguments_.length; index++) {
        const argument = arguments_[index];
        switch (argument) {
            case '--skipComments':
            case '-c': {
                skipComments = arguments_[++index];
                continue;
            }
            case '--escape':
            case '-e': {
                escape = arguments_[++index];
                continue;
            }
            case '--headers':
            case '-h': {
                headers = arguments_[++index];
                continue;
            }
            case '--output':
            case '-o': {
                output = arguments_[++index];
                continue;
            }
            case '--quote':
            case '-q': {
                quote = arguments_[++index];
                continue;
            }
            case '--skipLines':
            case '-l': {
                skipLines = arguments_[++index];
                continue;
            }
            case '--separator':
            case '-s': {
                separator = arguments_[++index];
                continue;
            }
            case '--version':
            case '-v': {
                version = true;
                continue;
            }
            case '--help': {
                help = true;
                continue;
            }
            default: {
                defaultArguments.push(argument);
                continue;
            }
        }
    }
    return {
        skipComments,
        escape,
        headers,
        output,
        quote,
        skipLines,
        separator,
        version,
        help,
        defaultArgs: defaultArguments,
    };
}

const argv = parseArguments();
const [filename] = argv.defaultArgs;

if (argv.version) {
    console.log(package_.version);
    process.exit(0);
}

if (argv.help || (!filename && process.stdin.isTTY)) {
    console.error(`Usage: csv-parser [filename?] [options]
  --escape,-e         Set the escape character (defaults to quote value)
  --headers,-h        Explicitly specify csv headers as a comma separated list
  --help              Show this help
  --output,-o         Set output file. Defaults to stdout
  --quote,-q          Set the quote character ('"' by default)
  --remove            Remove headers from output
  --separator,-s      Set the separator character ("," by default)
  --skipComments,-c   Skip CSV comments that begin with '#'. Set a value to change the comment character.
  --skipLines,-l      Set the number of lines to skip to before parsing headers
  --strict            Require column length match headers length
  --version,-v        Print out the installed version
`);
    process.exit(1);
}

let input;
const output =
    argv.output && argv.output !== '-' ? fs.createWriteStream(argv.output) : process.stdout;
const options = {
    separator: argv.separator,
    strict: argv.strict,
    skipComments: argv.skipComments,
    skipLines: argv.skipLines,
};

if (argv.headers) {
    options.headers = argv.headers.toString().split(argv.separator);
}

if (argv.remove) {
    const removeHeaders = new Set(argv.remove.split(','));
    options.mapHeaders = (name) => {
        // eslint-disable-next-line unicorn/no-null -- Null is the public mapHeaders column-skipping sentinel.
        return removeHeaders.has(name) ? null : name;
    };
}

if (filename === '-' || !filename) {
    input = process.stdin;
} else if (fs.existsSync(filename)) {
    input = fs.createReadStream(filename);
} else {
    console.error(`File: ${filename} does not exist`);
    process.exit(2);
}

const serialize = () => {
    return new Transform({
        objectMode: true,
        transform(object, enc, callback) {
            callback(undefined, JSON.stringify(object) + EOL);
        },
    });
};

input.pipe(csv(options)).pipe(serialize()).pipe(output);
