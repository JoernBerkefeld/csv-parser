{
    "name": "@joern.berkefeld/csv-parser",
    "version": "5.0.0",
    "description": "Native ESM streaming CSV parser fork with a default factory API and CLI",
    "type": "module",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/JoernBerkefeld/csv-parser.git"
    },
    "author": "Mathias Buus (mafintosh)",
    "contributors": [
        "Jörn Berkefeld <joern.berkefeld@gmail.com> (fork modifications)"
    ],
    "maintainers": [
        "Jörn Berkefeld <joern.berkefeld@gmail.com>"
    ],
    "homepage": "https://github.com/JoernBerkefeld/csv-parser#readme",
    "bugs": "https://github.com/JoernBerkefeld/csv-parser/issues",
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "bin": {
        "csv-parser": "bin/csv-parser"
    },
    "main": "index.js",
    "types": "index.d.ts",
    "files": [
        "CHANGELOG.md",
        "bin/csv-parser",
        "index.js",
        "index.d.ts"
    ],
    "engines": {
        "node": "^22.22.2 || >=24.15.0"
    },
    "scripts": {
        "bench": "node bin/bench",
        "coverage": "node scripts/coverage.mjs && tsd && npm run test:types --no-workspaces && node --test scripts/tooling.test.mjs",
        "lint": "eslint . bin/csv-parser bin/bench --max-warnings 0",
        "lint:fix": "eslint . bin/csv-parser bin/bench --fix --fix-type layout --max-warnings 0",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "prepare": "husky",
        "check:lockfile": "node scripts/check-lockfile-registry-only.mjs",
        "security": "npm audit",
        "test": "ava && tsd && npm run test:types --no-workspaces && node --test scripts/tooling.test.mjs",
        "test:types": "tsc --noEmit --strict --skipLibCheck --module NodeNext --moduleResolution NodeNext --target ES2022 index.test-d.ts"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^22.20.5",
        "ava": "^8.1.2",
        "c8": "^12.0.0",
        "chalk": "^6.0.1",
        "concat-stream": "^2.0.0",
        "csv-spectrum": "^1.0.0",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jsdoc": "^65.4.2",
        "eslint-plugin-prettier": "^5.5.7",
        "eslint-plugin-unicorn": "^79.0.0",
        "execa": "^10.2.1",
        "globals": "^17.13.0",
        "globby": "^16.2.4",
        "husky": "^9.1.7",
        "prettier": "^3.9.10",
        "strip-ansi": "^7.2.0",
        "text-table": "^0.2.0",
        "tsd": "^0.33.0",
        "typescript": "~5.9.3"
    },
    "directories": {
        "example": "examples",
        "test": "test"
    },
    "keywords": [
        "csv",
        "parser",
        "fast",
        "json"
    ],
    "tsd": {
        "compilerOptions": {
            "module": "NodeNext",
            "moduleResolution": "NodeNext",
            "types": [
                "node"
            ],
            "typeRoots": [
                "./node_modules/@types"
            ]
        }
    },
    "ava": {
        "files": [
            "test/**/*.js",
            "!**/fixtures/**",
            "!**/helpers/**"
        ]
    }
}
